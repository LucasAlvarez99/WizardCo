# Copiá este archivo a ".env" (sin ".example") y completá con tus datos reales.
# Nunca subas el archivo ".env" real a GitHub — ya está en .gitignore.

# Access Token de Mercado Pago (Panel de Desarrolladores → Tus integraciones
# → tu aplicación → Credenciales). Arrancá con las de PRUEBA (TEST-...) y
# pasá a las de PRODUCCIÓN (APP_USR-...) recién cuando todo funcione.
MP_ACCESS_TOKEN=TEST-000000000000-000000-00000000000000000000000000000000-000000000

# Puerto donde corre este backend.
PORT=4000

# URL pública donde corre ESTE backend (sin barra final), para que Mercado
# Pago pueda mandar el webhook de confirmación de pago. En local no hace
# falta (podés usar ngrok para probarlo); en producción, la URL real de
# donde lo despliegues (Render, Railway, etc.).
PUBLIC_URL=

# Connection string de tu cluster de MongoDB Atlas (plan gratuito M0).
# Se obtiene en Atlas → tu cluster → "Connect" → "Drivers" → Node.js.
# Reemplazá <password> por la contraseña real de tu usuario de base de datos.
# NUNCA subas este valor real a GitHub — este archivo es solo un ejemplo.
MONGODB_URI=mongodb+srv://usuario:<password>@cluster0.xxxxx.mongodb.net/

# Nombre de la base dentro del cluster (opcional, por defecto "wizardco").
MONGODB_DB_NAME=wizardco

# --- Autenticación ---

# Secreto para firmar los JWT de sesión. Generá uno random y largo, por
# ejemplo con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# NUNCA reutilices un secreto de ejemplo en producción.
JWT_SECRET=cambiame-por-un-secreto-random-largo

# Cuánto dura la sesión antes de tener que loguearse de nuevo.
JWT_EXPIRES_IN=7d

# --- Email transaccional (Resend) para el código de verificación de cuenta ---
# Conseguí tu API key en https://resend.com (cuenta gratis, 3000 emails/mes).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Remitente de los emails de verificación. Con la cuenta gratis de Resend
# tenés que usar el dominio de prueba "onboarding@resend.dev" hasta que
# verifiques tu propio dominio (ver Resend → Domains).
RESEND_FROM_EMAIL=WizardCo <onboarding@resend.dev>
